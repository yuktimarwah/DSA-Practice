class Solution {
    public ListNode reverse(ListNode head){
        ListNode curr = head;
        ListNode prev = null;
        while(curr!=null){
            ListNode a = curr.next;
            curr.next = prev;
            prev = curr;
            curr = a;
        }
        return prev;
    }
    public int pairSum(ListNode head) {
        ListNode slow = head;
        ListNode fast = head;
        while(fast.next.next!=null){
            slow = slow.next;
            fast = fast.next.next;
        }
        ListNode aftermid = reverse(slow.next);
        slow.next = aftermid;
        ListNode p1 = head;
        ListNode p2 = slow.next;
        int maxsum = 0;
        while(p2!=null){
            int sum = p1.val + p2.val;
            if(sum>maxsum){
                maxsum = sum;
            }
            p1 = p1.next;
            p2 = p2.next;

        }
        return maxsum;
    }
}
